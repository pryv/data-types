{
  "name": "pryv-data-types",
  "version": "1.1.2",
  "private": true,
  "description": "Pryv event type references",
  "keywords": [
    "pryv",
    "event",
    "types"
  ],
  "homepage": "https://github.com/pryv/data-types#readme",
  "bugs": {
    "url": "https://github.com/pryv/data-types/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pryv/data-types.git"
  },
  "license": "BSD-3-Clause",
  "author": "Pryv <info@pryv.com> (https://pryv.com)",
  "main": "scripts/build.js",
  "scripts": {
    "batch-to-validate": "node scripts/batch-to-validation-cases.js",
    "build": "node scripts/build.js && node scripts/check-type-schemas.js",
    "license": "source-licenser --config-file .licenser.yml ./",
    "lint": "eslint .",
    "validate-content": "node scripts/validate.js",
    "validate-schema": "node scripts/check-type-schemas.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "clone": "^2.1.2"
  },
  "devDependencies": {
    "neostandard": "^0.12.2",
    "source-licenser": "^2.0.6"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "lodash": "^4.18.1"
  }
}
